@using TheReviewer.Frontend.Models
@using TheReviewer.Logic.Models
@model MediaViewModel

@{
    ViewData["Title"] = "Game Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Games</h1>

<p>
    <a asp-controller="Media" asp-action="CreateGame" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Game title</th>
            <th>Publisher</th>
            <th>Reviewer</th>
            <th>Score</th>
            <th>Review</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model?.Media != null && Model.Media.Any())
        {
            foreach (var game in Model.Media)
            {
                var gameReviews = Model.Reviews?.Where(r => r.MediaId == game.Id).ToList() ?? new List<ReviewModel>();

                if (gameReviews.Any())
                {
                    foreach (var review in gameReviews)
                    {
                        var reviewer = Model.Reviewers?.FirstOrDefault(r => r.Id == review.ReviewerId);
                        var detailId = $"detail-game-{game.Id}-review-{review.Id}";

                        <tr class="clickable-row" style="cursor:pointer;" data-target="@detailId">
                            <td>@game.Name</td>
                            <td>@game.Publisher</td>
                            <td>@(reviewer?.Name ?? "Unknown")</td>
                            <td>@review.Rating</td>
                            <td>@(review.Content?.Length > 40 ? review.Content.Substring(0, 40) + "..." : review.Content)</td>
                            <td>
                                <a asp-controller="Media" asp-action="CreateGame">Edit</a> |
                                <a asp-controller="Media" asp-action="Games">Details</a> |
                                <a asp-controller="Media" asp-action="Games">Delete</a>
                            </td>
                        </tr>

                        <tr id="@detailId" style="display:none;">
                            <td colspan="6">
                                <div class="p-3 border rounded bg-light">
                                    <div class="row mb-2">
                                        <div class="col text-start fw-bold">@game.Name</div>
                                        <div class="col text-center">@game.Publisher</div>
                                        <div class="col text-end">@(reviewer?.Name ?? "Unknown")</div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col text-center">
                                            <div style="white-space: pre-wrap;">@review.Content</div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col text-center">
                                            <strong>Score:</strong> @review.Rating
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    var detailId = $"detail-game-{game.Id}-noreview";

                    <tr class="clickable-row" style="cursor:pointer;" data-target="@detailId">
                        <td>@game.Name</td>
                        <td>@game.Publisher</td>
                        <td>—</td>
                        <td>—</td>
                        <td>No reviews yet</td>
                        <td>
                            <a asp-controller="Media" asp-action="CreateGame">Edit</a> |
                            <a asp-controller="Media" asp-action="Games">Delete</a>
                        </td>
                    </tr>

                    <tr id="@detailId" style="display:none;">
                        <td colspan="6">
                            <div class="p-3 border rounded bg-light">
                                <div class="row mb-2">
                                    <div class="col text-start fw-bold">@game.Name</div>
                                    <div class="col text-center">@game.Publisher</div>
                                    <div class="col text-end">No reviewer</div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col text-center">
                                        No reviews yet
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        }
        else
        {
            <tr>
                <td colspan="6">No games found.</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.querySelectorAll('.clickable-row').forEach(row => {
            row.addEventListener('click', function (e) {
                if (e.target.tagName === 'A') return;

                const targetId = this.getAttribute('data-target');
                const detailRow = document.getElementById(targetId);
                if (detailRow) {
                    detailRow.style.display = detailRow.style.display === 'none' ? 'table-row' : 'none';
                }
            });
        });
    </script>
}