@using TheReviewer.Frontend.Models
@model CreateReviewViewModel
@{
    ViewData["Title"] = "Edit Film Review";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit Film Review</h1>

<hr/>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* hidden Id and MediaTypeId so POST knows what to update and where to redirect *@
            <input asp-for="Id" type="hidden" />
            <input asp-for="MediaTypeId" type="hidden" />

            <div class="form-group mb-3">
                <label asp-for="MediaId" class="control-label">Select a film</label>
                <select asp-for="MediaId" asp-items="Model.MediaItems" class="form-control">
                    <option value="">-- Select a film --</option>
                </select>
                <span asp-validation-for="MediaId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ReviewerId" class="control-label">Select a reviewer</label>
                <select asp-for="ReviewerId" asp-items="Model.ReviewerItems" class="form-control"></select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Score" class="control-label">Enter a score</label>
                <input asp-for="Score" type="number" class="form-control" />
                <span asp-validation-for="Score" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Content" class="control-label">What do you want to add to your review?</label>
                <textarea asp-for="Content" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-controller="Media" asp-action="Films">Back to List</a>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}