@using TheReviewer.Frontend.Models
@using TheReviewer.Logic.Models
@model MediaViewModel

@{
    ViewData["Title"] = "Film Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Films</h1>

<p>
    <a asp-controller="Media" asp-action="CreateFilm" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Film title</th>
            <th>Publisher</th>
            <th>Reviewer</th>
            <th>Score</th>
            <th>Review</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model?.Media != null && Model.Media.Any())
        {
            foreach (var film in Model.Media)
            {
                var filmReviews = Model.Reviews?.Where(r => r.MediaId == film.Id).ToList() ?? new List<ReviewModel>();

                if (filmReviews.Any())
                {
                    foreach (var review in filmReviews)
                    {
                        var reviewer = Model.Reviewers?.FirstOrDefault(r => r.Id == review.ReviewerId);
                        <tr>
                            <td>@film.Name</td>
                            <td>@film.Publisher</td>
                            <td>@(reviewer?.Name ?? "Unknown")</td>
                            <td>@review.Rating</td>
                            <td>@review.Content</td>
                            <td>
                                <a asp-controller="Media" asp-action="CreateFilm">Edit</a> |
                                <a asp-controller="Media" asp-action="Films">Details</a> |
                                <a asp-controller="Media" asp-action="Films">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td>@film.Name</td>
                        <td>@film.Publisher</td>
                        <td>—</td>
                        <td>—</td>
                        <td>No reviews yet</td>
                        <td>
                            <a asp-controller="Media" asp-action="CreateFilm">Edit</a> |
                            <a asp-controller="Media" asp-action="Films">Details</a> |
                            <a asp-controller="Media" asp-action="Films">Delete</a>
                        </td>
                    </tr>
                }
            }
        }
        else
        {
            <tr>
                <td colspan="6">No films found.</td>
            </tr>
        }
    </tbody>
</table>