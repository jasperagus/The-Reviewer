@using TheReviewer.Frontend.Models
@using TheReviewer.Logic.Models
@model MediaViewModel

@{
    ViewData["Title"] = "Film Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Films</h1>

<p>
    <a asp-controller="Review" asp-action="CreateFilm" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Film title</th>
            <th>Publisher</th>
            <th>Avg score</th>
            <th># Reviews</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model?.Media != null && Model.Media.Any())
        {
            foreach (var film in Model.Media)
            {
                var reviewCount = Model.Reviews?.Count(r => r.MediaId == film.Id) ?? 0;
                var averageScore = Model.GetAverageScore(film.Id);
                <tr>
                    <td>
                        <a asp-controller="Media" asp-action="Details" asp-route-id="@film.Id" asp-route-mediaTypeId="@Model.MediaTypeId">
                            @film.Name
                        </a>
                    </td>
                    <td>@film.Publisher</td>
                    <td>@averageScore</td>
                    <td>@reviewCount</td>
                    <td>
                        <a asp-controller="Review" asp-action="CreateFilm">Add review</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5">No films found.</td></tr>
        }
    </tbody>
</table>
