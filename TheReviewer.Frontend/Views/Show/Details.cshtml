@using TheReviewer.Frontend.Models
@using TheReviewer.Logic.Models
@model MediaViewModel

@{
    ViewData["Title"] = "Show details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (Model?.Media == null || !Model.Media.Any())
{
    <div>Media not found.</div>
}
else
{
    var show = Model.Media.First();
    var averageScore = Model.GetAverageScore(show.Id);
    <h1>@show.Name</h1>
    <p><strong>Publisher:</strong> @show.Publisher</p>
    <p><strong>Avg score:</strong> @averageScore</p>
    <p><strong>Episodes:</strong> @(show.Episodes?.ToString() ?? "-")</p>

    <h3>Reviews (@(Model.Reviews?.Count ?? 0))</h3>

    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        <style>
            .review-row {
                cursor: pointer;
                background-color: #f9f9f9;
            }
            .review-row:hover {
                background-color: #f0f0f0;
            }
            .review-row td {
                vertical-align: middle;
                padding: 12px !important;
            }
            .review-dropdown {
                display: none;
            }
            .review-dropdown.show {
                display: table-row;
            }
            .review-content-cell {
                padding: 10px 16px 8px !important;
                background-color: #f1f1f1;
                border: 2px solid #858585;
                color: #111;
            }
            .review-expanded-header {
                display: grid;
                grid-template-columns: 1fr auto 1fr;
                align-items: center;
                gap: 12px;
                font-weight: 700;
                font-size: 0.9rem;
            }
            .review-expanded-reviewer {
                text-align: center;
                font-size: 0.75rem;
            }
            .review-content-text {
                white-space: pre-wrap;
                word-wrap: break-word;
                line-height: 1.1;
                max-width: 250px;
                margin-top: 6px;
                padding-left: 6px;
                font-weight: 700;
            }
            .review-actions {
                display: flex;
                justify-content: flex-end;
                gap: 4px;
            }
            .review-actions a,
            .review-actions button {
                background: #f1f1f1;
                border: 2px solid #858585;
                border-radius: 0;
                color: #111;
                font-size: 0.8rem;
                line-height: 1;
                padding: 4px 12px;
                text-decoration: none;
            }
            .review-actions a:hover,
            .review-actions button:hover {
                background: #e4e4e4;
                color: #111;
            }
            .review-actions form {
                display: inline-flex;
            }
            .review-expanded-score {
                margin-top: 12px;
                text-align: center;
                font-weight: 700;
            }
        </style>

        <table class="table">
            <thead>
                <tr>
                    <th style="width: 30%;">Media</th>
                    <th style="width: 30%;">Reviewer</th>
                    <th style="width: 40%;">Score</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model.Reviews)
                {
                    var reviewer = Model.Reviewers?.FirstOrDefault(r => r.Id == review.ReviewerId);
                    var reviewId = "review-" + review.Id;
                    <tr class="review-row" onclick="toggleReview('@reviewId')">
                        <td>@show.Name</td>
                        <td>@(reviewer?.Name ?? "Unknown")</td>
                        <td>@review.Rating</td>
                    </tr>
                    <tr class="review-dropdown" id="@reviewId">
                        <td colspan="3">
                            <div class="review-content-cell">
                                <div class="review-expanded-header">
                                    <div>@show.Name</div>
                                    <div class="review-expanded-reviewer">@(reviewer?.Name ?? "Unknown")</div>
                                    <div class="review-actions">
                                        <a asp-controller="Review"
                                           asp-action="Edit"
                                           asp-route-id="@review.Id"
                                           asp-route-mediaTypeId="@Model.MediaTypeId">Edit</a>

                                        <form asp-controller="Review"
                                              asp-action="Delete"
                                              asp-route-id="@review.Id"
                                              asp-route-mediaTypeId="@Model.MediaTypeId"
                                              method="post"
                                              onsubmit="event.stopPropagation(); return confirm('Are you sure you want to delete this review?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit">Delete</button>
                                        </form>
                                    </div>
                                </div>
                                <div class="review-content-text">@review.Content</div>
                                <div class="review-expanded-score">@review.Rating/10</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <script>
            function toggleReview(reviewId) {
                const dropdown = document.getElementById(reviewId);
                dropdown.classList.toggle('show');
            }
        </script>
    }
    else
    {
        <div>No reviews yet for this show. <a asp-controller="Review" asp-action="CreateShow">Add one</a>.</div>
    }
}

